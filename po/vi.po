#: data/pantheon-tweaks.desktop.in:10
msgid "Advanced;Preferences;Fonts;Theme;Volume;Files;Terminal;"
msgstr "Advanced;Preferences;Fonts;Theme;Volume;Files;Terminal;"

#: data/pantheon-tweaks.metainfo.xml.in.in:12
msgid ""
"A system customization app for the Pantheon Desktop that lets you easily and "
"safely customise your desktop's appearance."
msgstr ""
"Một ứng dụng tùy chỉnh hệ thống dành cho Pantheon Desktop cho phép bạn tùy "
"chỉnh giao diện màn hình của mình một cách dễ dàng và an toàn."

#: data/pantheon-tweaks.metainfo.xml.in.in:19
#: data/pantheon-tweaks.metainfo.xml.in.in:23
msgid "Appearance pane"
msgstr "Khung giao diện"

